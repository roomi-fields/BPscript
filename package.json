{
  "name": "bpscript",
  "version": "0.8.0",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "arch": "depcruise \"src/transpiler/**/*.js\" --config .dependency-cruiser.cjs && node src/transpiler/libs-bundle-check.js",
    "typecheck": "node scripts/typer-les-corps.mjs",
    "verify": "npm run arch --silent && npm run typecheck --silent && npm run bundle:check --silent && node test/ast_conformance.mjs && node test/run_guards.mjs && npm run garde:documentaires --silent && npm run garde:source-voisine --silent && npm run garde:carte --silent && npm run garde:construire --silent && npm run garde:assiette --silent",
    "bundle:check": "node src/transpiler/libs-bundle-check.js",
    "prepare": "(npm run gate:install || true)",
    "guards": "node test/run_guards.mjs",
    "gate:install": "git config core.hooksPath .githooks && echo \"[gate] core.hooksPath=.githooks — git execute .githooks/pre-push (versionne, executable)\"",
    "fiche:etat": "node scripts/fiche-etat.mjs > baseline-status.json.tmp && mv baseline-status.json.tmp baseline-status.json",
    "garde:documentaires": "bash scripts/garde-documentaires.sh",
    "garde:source-voisine": "python3 ~/dev/bp/hub/tools/garde-source-voisine.py",
    "carte": "node scripts/carte-du-reel.mjs",
    "garde:carte": "node scripts/carte-du-reel.mjs --verifier",
    "assiette": "node scripts/assiette.mjs",
    "garde:assiette": "node scripts/assiette.mjs --verifier",
    "bundle:syntaxe": "node src/transpiler/syntaxe-bundle.mjs > src/transpiler/syntaxe-data.js.tmp && mv src/transpiler/syntaxe-data.js.tmp src/transpiler/syntaxe-data.js",
    "bundle:gabarits": "node src/transpiler/gabarits-bundle.mjs > src/transpiler/gabarits-data.js.tmp && mv src/transpiler/gabarits-data.js.tmp src/transpiler/gabarits-data.js",
    "publier": "node scripts/publier.mjs",
    "construire": "node scripts/construire.mjs && node scripts/deriver-files.mjs",
    "garde:construire": "node scripts/construire.mjs --verifier && node scripts/deriver-files.mjs --verifier"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.8",
    "dependency-cruiser": "^16.0.0",
    "esbuild": "^0.28.2",
    "langium": "^4.3.1",
    "langium-cli": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orderTokens": {
      "types": "./dist/orderTokens.d.ts",

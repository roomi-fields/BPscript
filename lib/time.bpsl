types

// @documented
// @description Time that ELAPSES — the scene's metronome. HEADER library, resolved by KRONOS.
def time(
  resolvedBy:Kronos,
  resolves:time,
  name:time,
  version:"1.0.0",
  section:subgrammar
)

// @description Absolute metronome of the scene or subgrammar, in BPM.
def tempo(
  bp3:_mm,
  args("bpm"),
  unit:bpm,
  scope("subgrammar", "scene"),
  unicite:metronome
)

// @description Clock catch-up delay when resuming after a wait point, in MILLISECONDS. Image of MIDIsyncDelay in the native engine.
control syncdelay(
  section:controls,
  bp3:MIDIsyncDelay,
  args("duration"),
  unit:ms,
  scope("scene")
)

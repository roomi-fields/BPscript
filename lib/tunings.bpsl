tuning western_just_c(
  description:"Western en intonation juste BP3, C-ancré (tonique C4 = 261.63 Hz, table native -to.tryOneScale). Le 'j' de Cj/Aj/Gj = marqueur de degré, parsé C/A/G ; TOUTES les notes rendues par cette même gamme juste (modèle Romain [428/429] : un tuning, pas d'alphabet parallèle). Distinct de western_just (A440-ancré). Tempérament bp3_just_intonation = coïncide avec just_5limit sur C/D/E/F/G/A (degrés 0,2,4,5,7,9).",
  alphabet:western,
  temperament:bp3_just_intonation,
  degrees(0, 2, 4, 5, 7, 9, 11),
  baseNote:C,
  diapason:261.63
)


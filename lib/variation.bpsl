types

// @documented
// @description DISCRETE variation modes of playing parameters — fixed and steps. Between two written values of the same parameter, the mode
// says whether the first HOLDS until the second (fixed) or GLIDES from note to note (steps). These two modes resolve at the note, hence
// before any sound is emitted: they belong to Kairos. The third mode — continuous — glides DURING notes, through intermediate messages: it
// can only be rendered by whoever emits, and it therefore lives in the library of its parameter.
def variation(
  resolves:variation,
  resolvedBy:"Kairos",
  name:variation,
  version:0.1.0,
  section:controls
)

// @description Velocity in FIXED mode — the written value holds until the next one, clean jump.
control velfixed(
  bp3:_velfixed,
  scope(symbol, group, rule, flow)
)

// @description Velocity BY STEPS — the value glides from note to note between two written values.
control velstep(
  bp3:_velstep,
  scope(symbol, group, rule, flow)
)

// @description Modulation in FIXED mode — the written value holds until the next one, clean jump.
control modfixed(
  bp3:_modfixed,
  scope(symbol, group, rule, flow)
)

// @description Modulation BY STEPS — the value glides from note to note between two written values.
control modstep(
  bp3:_modstep,
  scope(symbol, group, rule, flow)
)

// @description Pitchbend in FIXED mode — the written value holds until the next one, clean jump.
control pitchfixed(
  bp3:_pitchfixed,
  scope(symbol, group, rule, flow)
)

// @description Pitchbend BY STEPS — the value glides from note to note between two written values.
control pitchstep(
  bp3:_pitchstep,
  scope(symbol, group, rule, flow)
)

// @description Pressure in FIXED mode — the written value holds until the next one, clean jump.
control pressfixed(
  bp3:_pressfixed,
  scope(symbol, group, rule, flow)
)

// @description Pressure BY STEPS — the value glides from note to note between two written values.
control presstep(
  bp3:_presstep,
  scope(symbol, group, rule, flow)
)

// @description Volume in FIXED mode — the written value holds until the next one, clean jump.
control volumefixed(
  bp3:_volumefixed,
  scope(symbol, group, rule, flow)
)

// @description Volume BY STEPS — the value glides from note to note between two written values.
control volumestep(
  bp3:_volumestep,
  scope(symbol, group, rule, flow)
)

// @description Articulation in FIXED mode — the written value holds until the next one, clean jump. Articulation is set by legato and
// staccato.
control articulfixed(
  bp3:_articulfixed,
  scope(symbol, group, rule, flow)
)

// @description Articulation BY STEPS — the value glides from note to note between two written values.
control articulstep(
  bp3:_articulstep,
  scope(symbol, group, rule, flow)
)

// @description Panning in FIXED mode — the written value holds until the next one, clean jump.
control panfixed(
  bp3:_panfixed,
  scope(symbol, group, rule, flow)
)

// @description Panning BY STEPS — the value glides from note to note between two written values.
control panstep(
  bp3:_panstep,
  scope(symbol, group, rule, flow)
)

// @description Key map in FIXED mode — the written map holds until the next one, clean jump.
control mapfixed(
  bp3:_mapfixed,
  scope(symbol, group, rule, flow)
)

// @description Key map BY STEPS — the map glides from note to note between two written maps.
control mapstep(
  bp3:_mapstep,
  scope(symbol, group, rule, flow)
)

// @description Transposition in FIXED mode — the written value holds until the next one, clean jump.
control transposefixed(
  bp3:_transposefixed,
  scope(symbol, group, rule, flow)
)

// @description Transposition BY STEPS — the value glides from note to note between two written values.
control transposestep(
  bp3:_transposestep,
  scope(symbol, group, rule, flow)
)

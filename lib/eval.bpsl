// @documented
def eval(resolvedBy:runtime-codevoices, name:eval, type:code, section:objects)

// @description Patterns and samples, in the browser.
eval strudel(
  parameters(
    // @description The sample bank the voice loads. Without it, a scene using sample names plays SILENT.
    bank()
  )
)

// @description Visual synthesis.
eval hydra()

// @description SuperCollider — audio synthesis, native backend.
eval sc()

// @description JavaScript evaluated by the runtime.
eval js()

// @description TypeScript — the language of library bodies, transpiled then executed by the resolver the library names.
eval ts()

// @description Croquis graphiques p5.js.
eval p5()

// @description Live coding minimal.
eval mercury()

// @description Csound — synthesis, native backend.
eval csound()

// @description TidalCycles — motifs, backend natif (SuperDirt).
eval tidal()

// @description Literal text, evaluated by no one. Carries a SENTENCE where the language has no escape character: a library description, a
// label.
eval txt()

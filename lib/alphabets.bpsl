types

// @documented
def alphabets(resolvedBy:Kairos, resolves:alphabet)

// @description Western chromatic — 7 natural notes, 5 alteration levels
alphabet western(
  runtime:audio,
  tuning:western_12TET,
  octaves:western,
  diapason:440,
  resolvesPitch:true,
  alterations(bb:-2, b:-1, "":0, "#":1, "##":2),
  baseNote:A,
  baseRegister:"4",
  terminals(C(), D(), E(), F(), G(), A(), B())
)

// @description Indian sargam — 7 svaras
alphabet sargam(
  runtime:audio,
  tuning:sargam_12TET,
  octaves:saptak,
  diapason:240,
  resolvesPitch:true,
  alterations(komal:-1, "":0, tivra:1),
  baseNote:sa,
  baseRegister:madhya,
  terminals(sa(), re(), ga(), ma(), pa(), dha(), ni())
)

// @description Sargam AS THE NATIVE BP3 ENGINE NAMES IT (INDIAN note convention) — BP3 test alphabet, alongside the others (Romain's ruling
// 2026-07-19)
alphabet bp3_indian(
  runtime:audio,
  tuning:bp3_indian_12TET,
  octaves:bp3,
  diapason:440,
  resolvesPitch:true,
  alterations(k:-1, "":0, "#":1),
  baseNote:dha,
  baseRegister:"4",
  terminals(sa(), re(), ga(), ma(), pa(), dha(), ni())
)

// @description ENGLISH note convention of the native BP3 engine — BP3 test alphabet, alongside the others (Romain's decision 2026-07-29:
// the mechanism uses only alphabets)
alphabet bp3_english(
  runtime:audio,
  tuning:bp3_english_12TET,
  octaves:bp3,
  diapason:440,
  resolvesPitch:true,
  alterations(b:-1, "":0, "#":1),
  baseNote:A,
  baseRegister:"4",
  terminals(C(), D(), E(), F(), G(), A(), B())
)

// @description FRENCH note convention of the native BP3 engine — BP3 test alphabet, alongside the others (Romain's decision 2026-07-29)
alphabet bp3_fr(
  runtime:audio,
  tuning:bp3_fr_12TET,
  octaves:bp3_fr,
  diapason:440,
  resolvesPitch:true,
  alterations(b:-1, "":0, "#":1),
  baseNote:la,
  baseRegister:"3",
  terminals(do(), re(), mi(), fa(), sol(), la(), si())
)

// @description Latin solfège — do ré mi fa sol la si
alphabet solfege(
  runtime:audio,
  tuning:solfege_12TET,
  octaves:western,
  diapason:440,
  resolvesPitch:true,
  alterations(bb:-2, b:-1, "":0, "#":1, "##":2),
  baseNote:la,
  baseRegister:"4",
  terminals(do(), re(), mi(), fa(), sol(), la(), si())
)

// @description Arabic — 7 perde (degree names) with quarter-tone alterations. rast≈do, sikah = neutral third, awj = neutral seventh.
alphabet arabic(
  runtime:audio,
  tuning:arabic_24TET,
  diapason:440,
  resolvesPitch:true,
  alterations(bb:-4, b:-2, half_b:-1, "":0, "half_#":1, "#":2, "##":4),
  baseNote:husayni,
  terminals(rast(), dukah(), sikah(), jaharkah(), nawa(), husayni(), awj())
)

// @description Turkish makam — note names from Ottoman/Turkish tradition
alphabet turkish(
  runtime:audio,
  tuning:turkish_53TET,
  octaves:turkish,
  diapason:440,
  resolvesPitch:true,
  alterations(bakiye:4, kucuk_mucenneb:5, "":0, buyuk_mucenneb:8, tanini:9),
  baseNote:neva,
  baseRegister:"",
  terminals(
    kaba_cargah(),
    yegah(),
    huseyni_asiran(),
    acem_asiran(),
    irak(),
    rast(),
    dugah(),
    segah(),
    buselik(),
    cargah(),
    neva(),
    huseyni(),
    acem(),
    evic(),
    mahur(),
    gerdaniye()
  )
)

// @description Javanese gamelan pelog — 7 tones
alphabet gamelan_pelog(
  runtime:audio,
  tuning:gamelan_pelog,
  diapason:282,
  resolvesPitch:true,
  alterations(),
  baseNote:nem,
  terminals(nem(), barang(), bem(), gulu(), lima(), enam(), pitu())
)

// @description Javanese gamelan slendro — 5 tones
alphabet gamelan_slendro(
  runtime:audio,
  tuning:gamelan_slendro,
  diapason:282,
  resolvesPitch:true,
  alterations(),
  baseNote:nem,
  terminals(nem(), barang(), gulu(), dada(), lima())
)

// @description Shakuhachi — 5 base fingerings (Kinko-ryū)
alphabet shakuhachi(
  runtime:audio,
  tuning:shakuhachi_12TET,
  octaves:shakuhachi,
  diapason:293.66,
  resolvesPitch:true,
  alterations(meri:-1, "":0, kari:1),
  baseNote:ro,
  baseRegister:otsu,
  terminals(ro(), tsu(), re(), chi(), ri())
)

// @description Bohlen-Pierce — 13 pitch classes in a tritave
alphabet bohlen_pierce(
  runtime:audio,
  tuning:bohlen_pierce_equal,
  diapason:440,
  resolvesPitch:true,
  alterations(),
  baseNote:C,
  terminals(C(), Db(), D(), E(), F(), Gb(), G(), H(), Jb(), J(), A(), Bb(), B())
)

// @description Tabla bols — the ATOMIC syllables, those that no other one composes
alphabet tabla(
  runtime:audio,
  resolvesPitch:false,
  alterations(),
  terminals(
    dha(voice:bayan_open),
    ta(voice:dayan_tap),
    dhin(voice:bayan_open),
    tin(voice:dayan_ring),
    dhee(),
    tee(voice:dayan_open),
    ge(voice:bayan_open),
    ke(voice:bayan_muted),
    ra(),
    tr(),
    kt(voice:dayan_dry),
    ti(voice:dayan_tap),
    ne(),
    na(voice:dayan_ring),
    tk(),
    dhr(),
    ng(),
    gr(),
    te(),
    tt(),
    ki(),
    ka(voice:bayan_muted)
  )
)

// @description Abstract symbols — single lowercase letters, no pitch. For structural test scenes.
alphabet simple(
  runtime:audio,
  resolvesPitch:false,
  alterations(),
  terminals(
    a(),
    b(),
    c(),
    d(),
    e(),
    f(),
    g(),
    h(),
    i(),
    j(),
    k(),
    l(),
    m(),
    n(),
    o(),
    p(),
    q(),
    r(),
    s(),
    t(),
    u(),
    v(),
    w(),
    x(),
    y(),
    z(),
    Z(),
    filler(),
    b1(),
    c1(),
    d1()
  )
)

// @description 22-shruti as named by BP3 — 23 microtonal degrees (sa, r1..r4, g1..g4, m1, m2, m3p1, m4p2, p3, p4, d1..d4, n1..n4). Names
// verbatim from -to.tryShruti, tonic sa.
alphabet shruti23(
  runtime:audio,
  tuning:shruti23_native,
  octaves:saptak_us,
  diapason:261.625,
  resolvesPitch:true,
  alterations("":0),
  baseNote:sa,
  baseRegister:"4",
  terminals(
    sa(),
    r1(),
    r2(),
    r3(),
    r4(),
    g1(),
    g2(),
    g3(),
    g4(),
    m1(),
    m2(),
    m3p1(),
    m4p2(),
    p3(),
    p4(),
    d1(),
    d2(),
    d3(),
    d4(),
    n1(),
    n2(),
    n3(),
    n4()
  )
)

// @description Csound sound objects from the tryCsoundObjects test grammar (pitchless)
alphabet tryCsoundObjects(
  runtime:audio,
  resolvesPitch:false,
  alterations(),
  terminals(
    a(voice:dummy_csound_a),
    b(voice:dummy_csound_b),
    c(voice:dummy_csound_c),
    d(voice:dummy_csound_d),
    e(voice:dummy_csound_e),
    f(voice:dummy_csound_f),
    midiobject(voice:dummy_csound_midiobject)
  )
)

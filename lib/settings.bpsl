// @documented
// @description Default BP3 engine settings. Overridden by @ directives. Used to generate the settings string for bp3_load_settings().
def settings(
  resolvedBy:BPx,
  name:settings,
  version:"0.2.0",
  section:bp3_defaults
)

settings Quantization(name:Quantization, value:"10", unit:ms, boolean:"0")


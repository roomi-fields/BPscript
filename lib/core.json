{
  "name": "core",
  "description": "BPscript core — silences, prolongation, contrôles moteur, SOCLE des défauts de scène",
  "version": "0.2.0",
  "apporte": [
    "expression",
    "midi",
    "audio",
    "transpo",
    "engine",
    "variation",
    "eval",
    "midi_default"
  ],
  "schema": {
    "catalogAxes": [
      "alphabet",
      "tuning",
      "octaves",
      "scale",
      "sound",
      "eval"
    ],
    "deprecatedTransports": [
      "browser",
      "webaudio"
    ],
    "channels": {
      "audio": {
        "out": true,
        "writable": true,
        "params": {
          "gain": 1
        }
      },
      "midi": {
        "in": true,
        "out": true,
        "writable": true,
        "params": {
          "ch": 1
        }
      },
      "osc": {
        "in": true,
        "out": true,
        "writable": true,
        "params": {
          "host": "127.0.0.1",
          "port": 57120,
          "addr": "/kanopi"
        }
      },
      "keyboard": {
        "in": true,
        "writable": true
      },
      "dmx": {
        "out": true,
        "writable": true,
        "params": {
          "universe": 0
        }
      },
      "text": {
        "out": true,
        "writable": false
      }
    },
    "qualifierKeys": [
      "scan",
      "weight",
      "on_fail",
      "meter",
      "rotate",
      "legato",
      "staccato"
    ],
    "reservedDirectives": [
      "scale",
      "flag",
      "alphabet",
      "tuning",
      "octaves",
      "sound",
      "eval",
      "def",
      "init",
      "actor",
      "core",
      "ins",
      "transpose",
      "scaleshift",
      "chromashift",
      "sounds",
      "homomorphism",
      "test_alphabets",
      "settings",
      "filter",
      "modulation",
      "diapason",
      "var",
      "in",
      "out"
    ],
    "actorKeys": [
      "alphabet",
      "tuning",
      "octaves",
      "out",
      "eval"
    ],
    "deprecatedActorKeys": [
      "sound",
      "sounds",
      "voice"
    ],
    "varConventions": [
      "signal",
      "pitch",
      "phase",
      "logic"
    ]
  },
  "defaults": {
    "components": {
      "alphabet": "western",
      "tuning": "western_12TET",
      "octaves": "western",
      "transport": "audio"
    },
    "values": {
      "diapason": {
        "range": [
          16,
          8000
        ],
        "unit": "Hz",
        "overriddenBy": [
          "tuning.diapason",
          "alphabet.diapason"
        ],
        "description": "Hauteur de référence (Hz). Le défaut vient du champ `diapason` de l'ALPHABET EFFECTIF (acteur ?? scène `@alphabet.X` ?? alphabet par défaut @core `components.alphabet`) — l'ancre est une propriété du système de notes, pas de l'accordage (cf. SCENE_DEFAULTS_CASCADE.md). Overridable @diapason:N (scène) / (diapason:N) (occurrence). Si l'alphabet n'est pas résolu, la valeur reste ABSENTE (l'aval résout)."
      }
    }
  },
  "symbols": {
    "lambda": {
      "type": "special",
      "bp3": "lambda",
      "description": "Symbole vide — supprime le non-terminal. Utilisé pour effacer un symbole de la dérivation."
    }
  },
  "settings": {
    "on_fail": {
      "type": "directive",
      "values": [
        "skip",
        "retry",
        "fallback"
      ],
      "default": "skip",
      "description": "Gestion d'échec de dérivation"
    }
  }
}

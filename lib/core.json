{
  "documented": "yes",
  "resolves": "core",
  "name": "core",
  "description": "BPscript core — silences, prolongation, contrôles moteur, SOCLE des défauts de scène",
  "version": "0.2.0",
  "apporte": [
    "expression",
    "midi",
    "audio",
    "transpo",
    "engine",
    "time",
    "variation",
    "eval",
    "midi_default"
  ],
  "schema": {
    "catalogAxes": [
      "alphabet",
      "tuning",
      "octaves",
      "scale",
      "sound",
      "eval"
    ],
    "deprecatedTransports": [
      "browser",
      "webaudio"
    ],
    "channels": {
      "audio": {
        "out": true,
        "writable": true,
        "params": {
          "gain": 1
        }
      },
      "midi": {
        "in": true,
        "out": true,
        "writable": true,
        "params": {
          "ch": 1
        }
      },
      "osc": {
        "in": true,
        "out": true,
        "writable": true,
        "params": {
          "host": "127.0.0.1",
          "port": 57120,
          "addr": "/kanopi"
        }
      },
      "keyboard": {
        "in": true,
        "writable": true
      },
      "dmx": {
        "out": true,
        "writable": true,
        "params": {
          "universe": 0
        }
      },
      "text": {
        "out": true,
        "writable": false
      }
    },
    "qualifierKeys": [
      "scan",
      "weight",
      "on_fail",
      "meter",
      "rotate",
      "legato",
      "staccato"
    ],
    "reservedDirectives": [
      "scale",
      "alphabet",
      "tuning",
      "octaves",
      "sound",
      "eval",
      "def",
      "init",
      "actor",
      "core",
      "ins",
      "transpose",
      "scaleshift",
      "chromashift",
      "homomorphism",
      "settings",
      "filter",
      "modulation",
      "diapason",
      "out"
    ],
    "actorKeys": [
      "alphabet",
      "tuning",
      "octaves",
      "out",
      "eval"
    ],
    "deprecatedActorKeys": [
      "sound",
      "sounds",
      "voice"
    ],
    "_declarationTypes_doc": "LES MOTS QUI OUVRENT UNE DECLARATION PAR LE TYPE et que rien d autre ne derive. Les CONVENTIONS (varConventions) et les MODULES (les modules) en ouvrent une aussi, et se lisent la ou ils sont deja declares ; ces deux-la n ont pas d autre domicile. `flag` porte ses etats entre parentheses, `symbol` ne porte aucun type.",
    "declarationTypes": [
      "flag",
      "symbol",
      "control",
      "addresskey",
      "native",
      "destination",
      "enum",
      "object"
    ],
    "varConventions": [
      "signal",
      "pitch",
      "phase",
      "logic"
    ]
  },
  "defaults": {
    "components": {
      "alphabet": "western",
      "tuning": "western_12TET",
      "transport": "audio",
      "eval": "js"
    },
    "values": {
      "diapason": {
        "range": [
          16,
          8000
        ],
        "unit": "Hz",
        "overriddenBy": [
          "tuning.diapason",
          "alphabet.diapason"
        ],
        "description": "Hauteur de référence (Hz). Le défaut vient du champ `diapason` de l'ALPHABET EFFECTIF (acteur ?? scène `alphabet.X` ?? alphabet par défaut `core`, `components.alphabet`) — l'ancre est une propriété du système de notes, pas de l'accordage (cf. SCENE_DEFAULTS_CASCADE.md). Surchargeable par `diapason:N` en tête de scène, ou `(diapason:N)` sur une occurrence. Si l'alphabet n'est pas résolu, la valeur reste ABSENTE (l'aval résout)."
      }
    }
  },
  "symbols": {},
  "settings": {
    "on_fail": {
      "type": "directive",
      "values": [
        "skip",
        "retry",
        "fallback"
      ],
      "default": "skip",
      "description": "Gestion d'échec de dérivation"
    }
  }
}

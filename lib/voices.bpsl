// LA LIBRAIRIE « voices » — écrite dans le langage qu'elle sert.
//
// UN CORPS DE VOIX EST UNE FONCTION JAVASCRIPT SIMPLE, `(t, dur, env) => échantillon`.
// `t` est le temps local en secondes (0..dur), `dur` la durée de la note, et `env.pitch` porte
// la hauteur gravée en Hz. Une voix PERCUSSIVE ne lit jamais `env.pitch` : elle sonne sans
// hauteur. Le corps décrit son son directement — il ne compose aucune couche.
//
// ⚠️ LA CONSTANTE DE TEMPS D'UNE DÉCROISSANCE EST ÉCRITE EN SECONDES, dans le corps même.
//    Un argument nommé à unité (`decay:350ms`) n'est pas du JavaScript ; l'exponentielle l'est.
//
// ⛔ AUCUNE VOIX N'INVENTE DE HAUTEUR. Une voix pitchée sans hauteur gravée est SILENCIEUSE —
//    c'est ce que faisait la forme d'avant, et c'est ce que la page des voix du runtime publie.
//    Un repli `env.pitch||110` fait sonner à 110 Hz ce qui devait se taire : mesuré chez
//    runtime-audio, `wobble` rendait 7.52e-2 sans hauteur là où il devait rendre zéro.
//
// ⛔ LE BRUIT EST UNE FONCTION DU TEMPS, JAMAIS UN TIRAGE. `Math.random()` rend deux ondes
//    différentes pour la même note : inoffensif à l'oreille, fatal à qui compare deux rendus
//    échantillon par échantillon. Le hash ci-dessous est déterministe et se rejoue à l'identique.
//
// ⚠️ UNE NOTE EST UN COMMENTAIRE, plus une clé `_xxx` dans la donnée : un commentaire ne
//    voyage pas jusqu'aux consommateurs, une clé si.
//
// Chaque voix se déclare par son type en tête, `voice` — le prototype vit dans `types`, invoqué
// ci-dessous. La clé `section` dit seulement la place du paquet où elle se range.

types

// @documented
def voices (resolvedBy:Kairos, name:voices, resolves:voice)

voice wobble (audio:"`js: (t, dur, env) => (2*((t*env.pitch)%1)-1) * (0.55+0.45*Math.sin(2*Math.PI*5.5*t)) * Math.max(0,1-t/dur)`", section:objects)
voice fatbass (audio:"`js: (t, dur, env) => ((2*((t*env.pitch)%1)-1) + (2*((t*env.pitch*1.01)%1)-1)) * 0.4 * Math.max(0,1-t/dur)`", for(sub37(device(preset:bass-init, glide:0.2, osc1-wave:saw))), section:objects)
voice bayan_open (audio:"`js: (t) => { const h = Math.sin(t*99991)*43758.5453; const b = 2*(h-Math.floor(h))-1; return (Math.sin(2*Math.PI*80*t)*0.8 + b*0.2) * Math.exp(-t/0.35); }`", section:objects)
voice bayan_muted (audio:"`js: (t) => { const h = Math.sin(t*99991)*43758.5453; const b = 2*(h-Math.floor(h))-1; return (Math.sin(2*Math.PI*120*t)*0.5 + b*0.5) * Math.exp(-t/0.08); }`", section:objects)
voice dayan_ring (audio:"`js: (t) => (Math.sin(2*Math.PI*320*t) + Math.sin(2*Math.PI*480*t)) * 0.5 * Math.exp(-t/0.4)`", section:objects)
voice dayan_tap (audio:"`js: (t) => { const h = Math.sin(t*99991)*43758.5453; return (2*(h-Math.floor(h))-1) * Math.exp(-t/0.06); }`", section:objects)
voice dayan_dry (audio:"`js: (t) => (Math.sin(2*Math.PI*494*t) + Math.sin(2*Math.PI*587*t)) * 0.5 * Math.exp(-t/0.06)`", section:objects)
voice dayan_open (audio:"`js: (t) => (Math.sin(2*Math.PI*392*t) + Math.sin(2*Math.PI*494*t) + Math.sin(2*Math.PI*523*t) + Math.sin(2*Math.PI*587*t)) * 0.25 * Math.exp(-t/0.22)`", section:objects)
voice dummy_csound_a (audio:"`js: (t) => Math.sin(2*Math.PI*220*t) * Math.exp(-t/0.2)`", section:objects)
voice dummy_csound_b (audio:"`js: (t) => Math.sin(2*Math.PI*220*t) * Math.exp(-t/0.2)`", section:objects)
voice dummy_csound_c (audio:"`js: (t) => Math.sin(2*Math.PI*220*t) * Math.exp(-t/0.2)`", section:objects)
voice dummy_csound_d (audio:"`js: (t) => Math.sin(2*Math.PI*220*t) * Math.exp(-t/0.2)`", section:objects)
voice dummy_csound_e (audio:"`js: (t) => Math.sin(2*Math.PI*220*t) * Math.exp(-t/0.2)`", section:objects)
voice dummy_csound_f (audio:"`js: (t) => Math.sin(2*Math.PI*220*t) * Math.exp(-t/0.2)`", section:objects)
voice dummy_csound_midiobject (audio:"`js: (t) => Math.sin(2*Math.PI*220*t) * Math.exp(-t/0.2)`", section:objects)

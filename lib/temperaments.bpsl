// @description Pythagorean tuning — pure fifths (3/2). Comma: 531441/524288 ≈ 23.46 cents.
temperament pythagorean(
  period_ratio:2,
  divisions:12,
  ratios(1, 256/243, 9/8, 32/27, 81/64, 4/3, 729/512, 3/2, 128/81, 27/16, 16/9, 243/128)
)

// @description 5-limit just intonation — pure thirds and fifths.
temperament just_5limit(
  period_ratio:2,
  divisions:12,
  ratios(1, 16/15, 9/8, 6/5, 5/4, 4/3, 45/32, 3/2, 8/5, 5/3, 9/5, 15/8)
)

// @description 1/4-comma meantone — major thirds exactly 5/4. Fifths narrowed by 1/4 syntonic comma.
temperament meantone_quarter(
  period_ratio:2,
  divisions:12,
  ratios(
    1,
    1.044907,
    1.118034,
    1.196279,
    1.25,
    1.337481,
    1.397542,
    1.495349,
    1.5625,
    1.671851,
    1.788854,
    1.869186
  )
)

// @description 22 shruti — Indian tradition, 5-limit just intonation. Unequal steps (pramana ~22c, nyuna ~70c, purna ~90c).
temperament 22shruti(
  period_ratio:2,
  divisions:22,
  ratios(
    1,
    256/243,
    16/15,
    10/9,
    9/8,
    32/27,
    6/5,
    5/4,
    81/64,
    4/3,
    27/20,
    45/32,
    729/512,
    3/2,
    128/81,
    8/5,
    5/3,
    27/16,
    16/9,
    9/5,
    15/8,
    243/128
  )
)

// @description Bohlen-Pierce just — 7-limit, tritave (3:1). 13 steps.
temperament bohlen_pierce_just(
  period_ratio:3,
  divisions:13,
  ratios(1, 27/25, 25/21, 9/7, 7/5, 75/49, 5/3, 9/5, 49/25, 15/7, 7/3, 63/25, 25/9)
)

// @description Bohlen-Pierce equal — 13 equal divisions of the tritave (3:1).
temperament bohlen_pierce_equal(
  period_ratio:3,
  divisions:13,
  ratios(
    1,
    146.3c,
    292.6c,
    438.9c,
    585.2c,
    731.5c,
    877.8c,
    1024.1c,
    1170.4c,
    1316.7c,
    1463.0c,
    1609.3c,
    1755.6c
  )
)

// @description Gamelan pelog — 7-tone, Central Javanese approximation. Stretched octave. Varies by ensemble.
temperament gamelan_pelog(
  period_ratio:2.02,
  divisions:7,
  ratios(1, 1.126, 1.244, 1.351, 1.496, 1.683, 1.894)
)

// @description Gamelan slendro — near-equal pentatonic, Central Javanese approximation. Stretched octave.
temperament gamelan_slendro(
  period_ratio:2.01,
  divisions:5,
  ratios(1, 1.143, 1.317, 1.516, 1.741)
)


// Basse acide — l'enveloppe est ÉCRITE sur chaque phrase
//
// Le geste TB-303 : attaque courte, chute franche, tenue basse. Ici chaque phrase porte
// sa propre enveloppe, et c'est le CONTRASTE entre les phrases qui fait respirer la ligne
// — la première mord, la deuxième s'ouvre, la troisième tient. Le hasard les enchaîne.

core
alphabet.western:audio
tempo:132

-----
S -> Phrase Phrase Phrase Phrase

-----

mode:random

// Trois enveloppes, trois caractères. Le filtre s'ouvre et se referme d'une phrase à l'autre.
Phrase -> C2 C2 D#2 C2 (wave:sawtooth, vel:100, attack:2,  release:40,  weight:40)
Phrase -> C2 G2 A#2 G2 (wave:sawtooth, vel:88,  attack:14, release:160)
Phrase -> C2 _ D#2 F2  (wave:sawtooth, vel:76,  attack:40, release:280, weight:20)

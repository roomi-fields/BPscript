#!/usr/bin/env bash
# PORTILLON — hook VERSIONNÉ (installé par `npm run gate:install`).
#
# Il ne définit RIEN : il délègue à `npm run verify`, la définition UNIQUE du gate.
# Un hook qui reproduit la liste des vérifications finit par diverger d'elle — c'est
# la même dérive que la doc qui ment, appliquée au garde-fou lui-même.
set -e
cd "$(git rev-parse --show-toplevel)"
# ⛔ EN TETE, AVANT LE PORTILLON : on ne pousse pas sur un etat qu'on n'a pas fini de lire. Un geste
# qui sort d'ici part alors sur du courrier qu'on n'a pas vu — et « 0 non-lu » est le seul verdict,
# jamais l'ecran : le lot d'affichage est borne a quatre, donc une boite a six en montre quatre et
# une discipline juste devient un geste faux, en silence.
# ⇒ Ce garde REMPLACE l'appel a `garde-fenetre.sh`, retire le 2026-09-05 avec les fenetres de gel.
#   Ce script-la portait DEUX refus — la fenetre, et le courrier — et retirer le premier emportait le
#   second, qui n'a aucun rapport. *Deux refus dans un meme script sont DEUX gardes, et ils se
#   retirent separement.* Il vit au crochet de POUSSEE et nulle part ailleurs : pose a un site de
#   bascule, il mesure la fin d'un portillon de plusieurs minutes au lieu du geste.
# Garde partage, unique implementation dans le hub, laisse passer si la tour est injoignable.
BP_AGENT=bpscript bash "$HOME/dev/bp/hub/tools/garde-courrier-non-lu.sh" || exit 1
export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then nvm use 20 >/dev/null 2>&1 || nvm use 22 >/dev/null 2>&1; fi
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then echo "[gate] ERREUR : Node 20+ requis (actuel $(node -v)). Push bloque."; exit 1; fi
echo "[gate] node $(node -v) — npm run verify (definition UNIQUE du gate)…"
npm run verify --silent
echo "[gate] vert — push autorise."

# ⛔ PUBLIER NE DEMANDE AUCUN GESTE. Un producteur qui doit penser a publier n y pensera pas : la
# construction, la gravure et la bascule du lien vivent ICI, apres le vert, avant la poussee. Ce qui
# atteint mes consommateurs est alors un etat ENREGISTRE et NOMME, jamais mon arbre de travail.
# Les refus vivent dans `scripts/publication-refus.mjs`, en fonctions pures qui recoivent les faits.
npm run publier --silent
# ⛔ LES GARDES DOCUMENTAIRES NE VIVENT PLUS ICI — ils sont dans `verify`, appelés par
# `scripts/garde-documentaires.sh` (bascule tranchée par Romain le 2026-08-14).
# Ce bloc greffé les lançait au PUSH SEULEMENT : « verify vert » ne valait donc pas « portillon
# vert », et deux crochets d'un même dépôt pouvaient être à des niveaux différents sans que rien
# ne le dise. Le retirer d'ici les met au même niveau, quel que soit le crochet qui appelle verify.
# ⚠️ ET LE RETRAIT SE COMMITE, il ne se laisse pas dans l'arbre de travail : tant que mon HISTOIRE
# portait le bloc, remplacer X par Y n'avait supprimé X nulle part. Mesure avant de le dire fait :
# les gardes s'exécutaient DEUX fois par poussée — un doublon ne se voit pas au code de sortie.

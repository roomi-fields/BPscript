#!/usr/bin/env bash
# PORTILLON — hook VERSIONNÉ (installé par `npm run gate:install`).
#
# Il ne définit RIEN : il délègue à `npm run verify`, la définition UNIQUE du gate.
# Un hook qui reproduit la liste des vérifications finit par diverger d'elle — c'est
# la même dérive que la doc qui ment, appliquée au garde-fou lui-même.
set -e
cd "$(git rev-parse --show-toplevel)"
export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then nvm use 20 >/dev/null 2>&1 || nvm use 22 >/dev/null 2>&1; fi
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then echo "[gate] ERREUR : Node 20+ requis (actuel $(node -v)). Push bloque."; exit 1; fi
echo "[gate] node $(node -v) — npm run verify (definition UNIQUE du gate)…"
npm run verify --silent
echo "[gate] vert — push autorise."
# --- gardes documentaires du hub (deployer-gardes.sh) ---
# Source unique : hub/tools/. Jamais copiés ici — quinze copies divergeraient.
__hub="$(cd "$(git rev-parse --show-toplevel)/.." && pwd)/hub"
__moi="$(basename "$(git rev-parse --show-toplevel)")"
if [ -f "$__hub/tools/garde-navigation.py" ]; then
  python3 "$__hub/tools/garde-navigation.py" --depot "$__moi" || exit 1
  python3 "$__hub/tools/garde-copies.py"      --depot "$__moi" || exit 1
else
  # Un garde desarme par une absence de dossier est invisible : la poussee passait au vert sans que les
  # deux gardes documentaires aient tourne. Signale par runtime-in le 2026-08-14 ; le meme avertissement
  # muet vivait dans les quinze portillons.
  echo "✗ gardes documentaires INEXÉCUTABLES — hub introuvable à $__hub" >&2
  echo "  Ces gardes ne se sautent pas : sans eux, la poussée nest pas vérifiée." >&2
  exit 1
fi
# --- fin gardes documentaires ---

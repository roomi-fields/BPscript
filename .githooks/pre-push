#!/usr/bin/env bash
# PORTILLON — hook VERSIONNÉ (installé par `npm run gate:install`).
#
# Il ne définit RIEN : il délègue à `npm run verify`, la définition UNIQUE du gate.
# Un hook qui reproduit la liste des vérifications finit par diverger d'elle — c'est
# la même dérive que la doc qui ment, appliquée au garde-fou lui-même.
set -e
cd "$(git rev-parse --show-toplevel)"
export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then nvm use 20 >/dev/null 2>&1 || nvm use 22 >/dev/null 2>&1; fi
maj=$(node -v 2>/dev/null | sed "s/v\([0-9]*\).*/\1/")
if [ "${maj:-0}" -lt 20 ]; then echo "[gate] ERREUR : Node 20+ requis (actuel $(node -v)). Push bloque."; exit 1; fi
echo "[gate] node $(node -v) — npm run verify (definition UNIQUE du gate)…"
npm run verify --silent
echo "[gate] vert — push autorise."
# ⛔ LES GARDES DOCUMENTAIRES NE VIVENT PLUS ICI — ils sont dans `verify`, appelés par
# `scripts/garde-documentaires.sh` (bascule tranchée par Romain le 2026-08-14).
# Ce bloc greffé les lançait au PUSH SEULEMENT : « verify vert » ne valait donc pas « portillon
# vert », et deux crochets d'un même dépôt pouvaient être à des niveaux différents sans que rien
# ne le dise. Le retirer d'ici les met au même niveau, quel que soit le crochet qui appelle verify.
# ⚠️ ET LE RETRAIT SE COMMITE, il ne se laisse pas dans l'arbre de travail : tant que mon HISTOIRE
# portait le bloc, remplacer X par Y n'avait supprimé X nulle part. Mesure avant de le dire fait :
# les gardes s'exécutaient DEUX fois par poussée — un doublon ne se voit pas au code de sortie.
